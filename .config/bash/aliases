# Ubuntu names its packages batcat and fdfind; give them the upstream names
if command -v batcat &> /dev/null && ! command -v bat &> /dev/null; then
  alias bat='batcat'
fi
if command -v fdfind &> /dev/null && ! command -v fd &> /dev/null; then
  alias fd='fdfind'
fi

# Leaner than the Omarchy defaults: no long format, no icons.
if command -v eza &> /dev/null; then
  alias ls='eza --group-directories-first'
  alias lt='eza --tree --level=2 --long --git'
fi

if command -v kubecolor &> /dev/null; then
  alias kubectl=kubecolor
  alias k=kubectl
fi

if command -v irb &> /dev/null; then
  alias irb='irb --simple-prompt'
fi

if command -v rich-ri &> /dev/null; then
  alias ri='rich-ri'
fi

if command -v ghcitty &> /dev/null; then
  alias ghci='ghcitty'
fi

# dots (~/.local/bin/dots) fronts the dotfiles, private and nvim repos; dotp is git in the private one
alias dotp='dots private'

if command -v nvim &> /dev/null; then
  alias vim='nvim'
fi
