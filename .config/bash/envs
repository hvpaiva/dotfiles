# One pager everywhere. bat stays a file viewer (`bat main.rs`) and is never a $PAGER:
# a pager receives stdin with no filename, so bat cannot detect a syntax and highlights
# nothing, while turning the file less would seek into a pipe it must read end to end.
export PAGER=less
export LESS="-FRi"

# man through that same less. `-c` makes groff emit backspace overstrike instead of SGR
# attributes, which is what lets less colorize bold/italic/underline through the
# LESS_TERMCAP entries below. Overrides the Omarchy default of `col -bx | bat -l man -p`,
# which strips the emphasis and has bat guess it back from syntax.
export MANROFFOPT="-c"
unset MANPAGER

# Basic ANSI colors only, so man pages follow the terminal theme, like BAT_THEME=ansi.
export LESS_TERMCAP_md=$'\e[1;36m'    # bold      -> cyan (headings, command names)
export LESS_TERMCAP_us=$'\e[4;32m'    # underline -> green (arguments, italics)
export LESS_TERMCAP_so=$'\e[1;33;44m' # standout  -> status line and search hits
export LESS_TERMCAP_mb=$'\e[1;31m'    # blink     -> red
export LESS_TERMCAP_me=$'\e[0m'
export LESS_TERMCAP_ue=$'\e[0m'
export LESS_TERMCAP_se=$'\e[0m'

# bun's own install dir: wrangler and cf-wrangler live there. The bun binary is mise's,
# so this goes last on PATH.
export BUN_INSTALL="$HOME/.bun"
case ":$PATH:" in *":$BUN_INSTALL/bin:"*) ;; *) export PATH="$PATH:$BUN_INSTALL/bin" ;; esac

# Ruby ri: render docs as Markdown through glow (mise), which pages with $PAGER. Where
# bash-completion ships an ri completion (Ubuntu), the _ri_md wrapper in bash/functions
# keeps TAB completion working.
export RI='-f markdown'
export RI_PAGER='glow -p -'
