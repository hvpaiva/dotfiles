# Divergence from the Omarchy defaults only. Whatever matches upstream lives upstream.
source ~/.config/bash/envs
source ~/.config/bash/aliases
source ~/.config/bash/functions
source ~/.config/bash/prompt
source ~/.config/bash/mise-intercept
# Per-host settings (hosts/<host>, linked into place)
[[ -f ~/.config/bash/local ]] && source ~/.config/bash/local
# Sensitive per-host settings (private repo, linked into place)
[[ -f ~/.config/bash/private ]] && source ~/.config/bash/private
