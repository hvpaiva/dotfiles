# athena: this machine's on-disk key, named "athena" on GitHub
Host github.com
	IdentityFile ~/.ssh/id_ed25519_github
	IdentitiesOnly yes

# zeus only has en_US.UTF-8 generated; Ubuntu sends LANG=pt_BR.UTF-8 by default
# (SendEnv LANG in /etc/ssh/ssh_config) and the bash there complains about the locale
Host zeus
	SetEnv LANG=en_US.UTF-8
