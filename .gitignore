# Manifest of the personal layer. Everything under $HOME is ignored unless listed
# here, so `dots status` only ever reports files inside this boundary. Upstream
# Omarchy config, port-owned files, app state and per-host `local` files stay out.
/*
!/.gitignore
!/.gitmodules
!/.bashrc
!/.bash_profile
!/.profile
!/.XCompose
!/.inputrc

# ssh: the shared client config; keys and known hosts stay out, config.local is per host
!/.ssh/
/.ssh/*
!/.ssh/config

# Repo root: docs, the first-run script and CI. Tracked here but kept out of $HOME by a
# sparse checkout (dots root show|hide)
!/README.md
!/bootstrap.sh
!/.github/

# Claude Code: the shared instructions, skills, agents, hooks, statusline and theme.
# settings.json, CLAUDE.local.md, RTK.md and the work skills come per host (hosts/<host>);
# everything else in ~/.claude is state
!/.claude/
/.claude/*
!/.claude/CLAUDE.md
!/.claude/agents/
!/.claude/statusline/
!/.claude/themes/
!/.claude/hooks/
/.claude/hooks/*
!/.claude/hooks/compass-commit-check.sh
!/.claude/hooks/compass-context-monitor.sh
!/.claude/hooks/compass-preflight.sh
!/.claude/hooks/compass-scope-guardian.sh
!/.claude/hooks/herdr-agent-state.sh
!/.claude/hooks/check-no-gsd-vocab.sh
!/.claude/skills/
/.claude/skills/*
!/.claude/skills/compass-*/
!/.claude/skills/argo-*/
!/.claude/skills/avoid-ai-writing/
!/.claude/skills/devsecops/
!/.claude/skills/infra/
!/.claude/skills/graphify/

!/.config/
/.config/*

# Default applications: browser (xdg-settings writes here, and every app that registers a
# scheme handler) and the terminal order xdg-terminal-exec follows
!/.config/mimeapps.list
!/.config/xdg-terminals.list

# Shell
!/.config/bash/
/.config/bash/local
/.config/bash/private
!/.config/blesh/
/.config/blesh/local.sh

# Terminals: whole directories, so leftovers show up as untracked
!/.config/alacritty/
!/.config/ghostty/
!/.config/kitty/
!/.config/foot/

# Multiplexers
!/.config/tmux/
/.config/tmux/local.conf
!/.config/herdr/
/.config/herdr/*
!/.config/herdr/config.toml

# Omarchy: personal pieces only; the installed themes and the hooks stay out, except
# herdr-accent, the other half of herdr/config.toml (it copies the theme's accent there on
# every theme change). That rewrite and omarchy-shell's, which saves its settings panel to
# shell.json, both show up as changes to save
!/.config/omarchy/
/.config/omarchy/*
!/.config/omarchy/shell.toml
!/.config/omarchy/shell.json
!/.config/omarchy/themes.txt
!/.config/omarchy/defaults/
!/.config/omarchy/branding/
!/.config/omarchy/extensions/
!/.config/omarchy/hooks/
/.config/omarchy/hooks/*
!/.config/omarchy/hooks/theme-set.d/
/.config/omarchy/hooks/theme-set.d/*
!/.config/omarchy/hooks/theme-set.d/herdr-accent
!/.config/aether/
/.config/aether/*
!/.config/aether/theme.override.css

# Hyprland: only the personal bindings; hyprland.lua/autostart.lua are upstream (Zeus)
# or port glue (Athena), monitors.lua is per host
!/.config/hypr/
/.config/hypr/*
!/.config/hypr/bindings.lua
!/.config/hypr/monitors.lua
!/.config/hypr/input.lua

# Session
!/.config/uwsm/
/.config/uwsm/*
!/.config/uwsm/default
!/.config/autostart/
/.config/autostart/*
!/.config/autostart/com.onepassword.OnePassword.desktop

# Tools
!/.config/git/
/.config/git/local
/.config/git/private
/.config/git/allowed_signers
/.config/git/hooks.local/
!/.config/lazygit/
/.config/lazygit/*
!/.config/lazygit/config.yml
!/.config/mise/
/.config/mise/*
!/.config/mise/config.toml
!/.config/mise/default-gems
!/.config/packages/
/.config/packages/universal/chromium-extensions.local.txt
/.config/packages/sets
!/.config/scripts/
!/.config/shellcheckrc
!/.config/fontconfig/
/.config/fontconfig/*
!/.config/fontconfig/fonts.conf
!/.config/k9s/
/.config/k9s/*
!/.config/k9s/aliases.yaml
!/.config/k9s/config.yaml
!/.config/opencode/
/.config/opencode/*
!/.config/opencode/opencode.json
!/.config/Cursor/
/.config/Cursor/*
!/.config/Cursor/User/
/.config/Cursor/User/*
!/.config/Cursor/User/settings.json
!/.config/Cursor/User/keybindings.json
!/.config/sesh/
!/.config/tensaku/

# This repo's own support files: per-host trees and the container test
!/.config/dotfiles/

# Per-host marker written by dots setup (zeus, athena), used to pick the per-host layers
/.config/dotfiles/host

# Personal CLIs and their completion; nothing else under ~/.local
!/.local/
/.local/*
!/.local/bin/
/.local/bin/*
!/.local/bin/dots
!/.local/share/
/.local/share/*
!/.local/share/bash-completion/
/.local/share/bash-completion/*
!/.local/share/bash-completion/completions/
# Completion files are lazy loaders (a few lines each, run the tool's own
# generator on the first Tab), so they are tracked like any config. The kubectl
# ones are generated by dots setup and stay out.
/.local/share/bash-completion/completions/kubectl
/.local/share/bash-completion/completions/kubecolor
/.local/share/bash-completion/completions/k
!/.local/share/man/
/.local/share/man/*
!/.local/share/man/man1/
/.local/share/man/man1/*
!/.local/share/man/man1/dots.1
# Omarchy's editor default lives under state, next to the agent one under config
!/.local/state/
/.local/state/*
!/.local/state/omarchy/
/.local/state/omarchy/*
!/.local/state/omarchy/defaults/
