#!/usr/bin/env bash
# dots — the personal layer of this machine, kept in sync with hvpaiva/dotfiles.
# Three repositories behind one command: dotfiles (~/.dotfiles, bare, $HOME as work tree),
# private (~/.local/share/dotfiles-private) and nvim (~/.config/nvim, recorded in dotfiles
# as a submodule pointer). `dots help` and `man dots` document the commands.
#
# Environment overrides, for tests: DOTFILES_REPO, DOTFILES_PUSH_URL, DOTFILES_BRANCH,
# DOTFILES_PRIVATE_REPO, DOTS_OS_RELEASE.
# Sourcing this file defines the functions without running anything (the bats suite does).

PUBLIC_GIT_DIR=$HOME/.dotfiles
PUBLIC_PUSH_URL=${DOTFILES_PUSH_URL:-git@github.com:hvpaiva/dotfiles.git}
PUBLIC_BRANCH=${DOTFILES_BRANCH:-main}
PRIVATE_DIR=$HOME/.local/share/dotfiles-private
PRIVATE_REPO=${DOTFILES_PRIVATE_REPO:-git@github.com:hvpaiva/dotfiles-private.git}
NVIM_DIR=$HOME/.config/nvim
NVIM_PATH=.config/nvim
NVIM_REPO=https://github.com/hvpaiva/nvim.git
NVIM_PUSH_URL=git@github.com:hvpaiva/nvim.git
NVIM_BRANCH=main
AUGUR_DIR=$HOME/dev/personal/augur
AUGUR_REPO=https://github.com/hvpaiva/augur.git
AUGUR_PUSH_URL=git@github.com:hvpaiva/augur.git
PORT_DIR=$HOME/.local/share/omarchy-ubuntu
PORT_REPO=https://github.com/hvpaiva/omarchy-ubuntu.git
BOOTSTRAP_URL=https://raw.githubusercontent.com/hvpaiva/dotfiles/main/bootstrap.sh
FONT="MesloLGLDZ Nerd Font Mono"
STATE_DIR=$HOME/.local/state/dotfiles
HOST_FILE=$HOME/.config/dotfiles/host
HOSTS_DIR=$HOME/.config/dotfiles/hosts
TPM_DIR=$HOME/.local/share/tmux/plugins
PACMAN_HOOK=/etc/pacman.d/hooks/pkg-snapshot-append.hook
CHROMIUM_POLICY=/etc/chromium/policies/managed/dotfiles-extensions.json
CHROMIUM_EXT=$HOME/.config/packages/universal/chromium-extensions.txt
CHROMIUM_EXT_LOCAL=$HOME/.config/packages/universal/chromium-extensions.local.txt
# One 1Password item feeds every login setup can do by itself (dots help setup)
OP_ITEM=${DOTS_OP_ITEM:-op://Private/dots}
PERSONAL_EMAIL=contact@hvpaiva.dev
FETCH_TTL=600
# Tracked at the repo root, kept out of $HOME by a sparse checkout (bootstrap.sh writes the
# same patterns before the first checkout)
ROOT_ENTRIES=(README.md bootstrap.sh .github)
ROOT_PATTERNS=('/*' '!/README.md' '!/bootstrap.sh' '!/.github/')
# System packages the layer needs and mise cannot provide: compilers and headers for the
# tools that build here (augur, ble.sh, node native modules), tmux, fontconfig
ARCH_DEPS=(base-devel git curl tmux python libsecret fontconfig bash-completion)
UBUNTU_DEPS=(git curl ca-certificates build-essential gawk pkg-config libsecret-1-dev python3 tmux fontconfig bash-completion)
# Distro packages the layer replaces (mise or rustup provide the tool) or does not want at
# all (starship, zsh). Omarchy ships most of the Arch ones. The Ubuntu port installs mise
# through mise.run and nothing else from this list, so on Ubuntu they come from an earlier
# life of the machine.
ARCH_DROP=(herdr sesh-bin zoxide zsh fish fisher tree-sitter-cli mise-bin cliamp tobi-try starship glow rust-src rust rust-analyzer)
UBUNTU_DROP=(mise zoxide zsh fish starship)
STALE_NAMES=(herdr sesh zoxide starship cliamp tree-sitter mise try glow)

export PATH="$HOME/.local/bin:$HOME/.cargo/bin:$PATH:$HOME/.local/share/mise/shims"

# ── help ─────────────────────────────────────────────────────────────────────
usage() {
  cat <<'USAGE'
dots keeps this machine's personal layer in sync with hvpaiva/dotfiles: the dotfiles
repo (bare, $HOME as work tree), the private repo and the nvim repo, as one.

Usage:
  dots [command] [flags]

Commands:
  status    Changes, origin state and machine checks (default)
  diff      The changes, every repo
  save      Commit and push every change, every repo
  update    Update repos, per-host links and tools
  push      Push what is not on origin yet
  doctor    Check the machine against the intended state
  setup     Install or repair the whole layer
  root      Show or hide the root entries in $HOME
  clean     List or remove the backups setup left behind
  private   git in the private repo
  nvim      git in the nvim repo
  git       git in the dotfiles repo (so is any other command)

Use "dots help <command>" for details and "man dots" for the manual.
USAGE
}
help_for() { # COMMAND
  case $1 in
    status) cat <<'H'
Show what changed here, what is waiting on origin and what the machine lacks.

Three tables. REPO: branch, local changes, origin state and, for nvim, whether
the live commit is the one recorded in dotfiles. PATH: every changed or new file
inside the tracked boundary and the repo it belongs to. HOST: the per-host links,
the number of local checks that warn (dots doctor lists them) and, only while
some exist, the backups setup left behind (dots clean lists them). Origin is
fetched at most once every 10 minutes.

Usage:
  dots status [-f|--fetch] [-o|--offline]

Flags:
  -f, --fetch     fetch origin now
  -o, --offline   do not fetch

Examples:
  dots               same as dots status
  dots status -f
H
    ;;
    diff) cat <<'H'
Show the changes in every repo: git diff for tracked files, then the new files
inside the tracked boundary. Extra arguments are passed to git diff.

Usage:
  dots diff [git diff arguments]

Examples:
  dots diff
  dots diff --stat
H
    ;;
    save) cat <<'H'
Commit and push every change, in every repo, in this order: nvim, private,
dotfiles. The live nvim commit is recorded in dotfiles first when it moved
forward. Per-host files that a program replaced with a plain file are adopted:
copied back into their tree, re-linked and committed with the rest. A message is
asked per repo, with one proposed from the changed files; -m uses the same
message everywhere.

Usage:
  dots save [-m MESSAGE] [-n|--no-push]

Flags:
  -m, --message MESSAGE   commit message for every repo
  -n, --no-push           commit, do not push

Examples:
  dots save
  dots save -m "feat: sesh on prefix+s"
H
    ;;
    update) cat <<'H'
Bring the machine up to date: fast-forward every repo to origin (local edits are
stashed around the merge), re-link the per-host files, install the mise tools
the config lists but the machine lacks, then upgrade the mise tools, rebuild
augur when its repo moved and update the tmux plugins.

Usage:
  dots update [--quick]

Flags:
  --quick   repos, links and missing tools only, no upgrades

Examples:
  dots update
  dots update --quick
H
    ;;
    push) cat <<'H'
Push the commits that are not on origin yet, in every repo. Nothing is
committed. A repo whose origin moved is left alone: dots update first.

Usage:
  dots push
H
    ;;
    doctor) cat <<'H'
Check the machine against the intended state, one row per check: the three
repos (changes, origin, nvim record), host marker, per-host links, root entries,
git identity and hooks, Omarchy, build dependencies, mise and its tools, rust,
augur, ble.sh, tmux plugins, the Chromium extension policy, distro copies of
replaced tools, processes still running a removed binary, font, themes, kubectl
completion, a real login shell, GitHub over SSH, and the logins only a person can
do (1Password CLI, gh, Tailscale, the git signing key, the Cloudflare token).
Exit status is 1 when any check warns. dots status runs the local checks
silently and shows how many warn.

Usage:
  dots doctor
H
    ;;
    setup) cat <<'H'
Install or repair the whole layer. Idempotent: every step checks before acting.
The steps, in order: build dependencies (sudo); Omarchy, on Ubuntu through the
omarchy-ubuntu bootstrap; the dotfiles repo (remotes, sparse checkout,
fast-forward); host marker; secrets (below); private layer (needs GitHub over
SSH); per-host links; identity (git/local when no layer provides one, this
host's key among the allowed signers, the Cloudflare token file); neovim config;
distro packages the layer replaces (sudo); the pacman hook that records installs
(Arch, sudo); rustup; augur; ble.sh; tmux plugins; mise and every tool in
mise/config.toml; terminal font; themes; kubectl completion; the Chromium
extension policy (sudo). Then dots doctor and a summary. The output is also
written to ~/.local/state/dotfiles/setup.log. This is what bootstrap.sh runs
after the clone.

Secrets: unlock 1Password once (the app, with CLI integration on) and setup
does the logins itself from the item op://Private/dots (DOTS_OP_ITEM overrides
it): field github-token logs gh in (a token with repo, read:org,
admin:public_key, admin:ssh_signing_key); this machine's SSH key
(~/.ssh/id_ed25519, or the one ssh already offers github.com) is generated if
missing and added to GitHub for authentication and signing, so nothing asks
again afterwards; tailscale-auth-key connects Tailscale; cloudflare-token
writes ~/.local/state/cloudflare/token. A missing field is reported, never
fatal. Without 1Password the step says what is left to do by hand.

Usage:
  dots setup [--host NAME] [--reset] [--skip-omarchy] [--skip-private]
             [--skip-mise] [--skip-rust] [--skip-secrets]

Flags:
  --host NAME      which hosts/NAME layers this machine uses (asked once,
                   kept in ~/.config/dotfiles/host)
  --reset          drop local edits to tracked dotfiles and private files
  --skip-omarchy   leave Omarchy alone: port bootstrap, font, themes
  --skip-private   do not touch the private layer
  --skip-mise      do not install mise or its tools
  --skip-rust      do not install rustup or augur
  --skip-secrets   do not touch 1Password, gh, the SSH key or Tailscale

Examples:
  dots setup
  dots setup --host athena --skip-rust
H
    ;;
    root) cat <<'H'
README.md, bootstrap.sh and .github/ are tracked at the repo root and kept out
of $HOME by a sparse checkout. show puts them in $HOME to edit; hide takes them
out again; a modified one has to be saved first.

Usage:
  dots root show|hide

Examples:
  dots root show && $EDITOR ~/README.md && dots save && dots root hide
H
    ;;
    clean) cat <<'H'
List the backups setup, bootstrap.sh and the Ubuntu port move aside instead of
deleting, and remove them on request. They are the files the first checkout
would have overwritten (~/.local/state/dotfiles/pre-checkout-*), a ~/.config/nvim
that was not a git clone (nvim-*), the copies the port keeps next to a config it
replaces (~/.config/**.bak-omarchy) and the folders of a migration by hand
(~/.local/state/dotfiles-cleanup-*). Logs are never touched.

Usage:
  dots clean [--all] [-y|--yes]

Flags:
  --all       remove every backup listed, after a confirmation
  -y, --yes   do not ask (for scripts; --all without a terminal needs it)

Examples:
  dots clean            list them, with age and size
  dots clean --all      remove them, asking once
H
    ;;
    private | nvim | git) cat <<'H'
Run git in one of the repos: private (~/.local/share/dotfiles-private), nvim
(~/.config/nvim) or the dotfiles repo (bare ~/.dotfiles with $HOME as work
tree). Any command dots does not know is passed to git in the dotfiles repo.

Usage:
  dots private <git arguments>
  dots nvim <git arguments>
  dots git <git arguments>
  dots <git arguments>

Examples:
  dots log --oneline -5
  dots private status
  dots nvim log -1
H
    ;;
    *) usage ;;
  esac
}

# ── output ───────────────────────────────────────────────────────────────────
if [[ -t 1 ]]; then
  c_b=$'\e[1m' c_r=$'\e[31m' c_g=$'\e[32m' c_y=$'\e[33m' c_c=$'\e[36m' c_0=$'\e[0m'
else
  c_b='' c_r='' c_g='' c_y='' c_c='' c_0=''
fi
WARNINGS=()
line() { printf '%-10s %s%s%s\n' "$1" "${3:-}" "$2" "${3:+$c_0}"; } # NAME DETAIL [COLOUR]
warn() { WARNINGS+=("$1: $2"); line "$1" "$2" "$c_y"; }             # NAME DETAIL
die()  { printf '%serror:%s %s\n' "$c_r" "$c_0" "$*" >&2; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }
indent() { local l; while IFS= read -r l; do printf '%s%s\n' "$1" "$l"; done; }
SEP=$'\x1f'
row() { local IFS=$SEP; printf '%s\n' "$*"; }
cell_colour() { # TEXT COLUMN — kubecolor-like: state words by meaning, other columns alternate
  if [[ $1 =~ ^([0-9]+)/([0-9]+)(,.*)?$ ]]; then
    if [[ ${BASH_REMATCH[1]} == "${BASH_REMATCH[2]}" && -z ${BASH_REMATCH[3]} ]]; then printf '%s' "$c_g"; else printf '%s' "$c_y"; fi
    return 0
  fi
  case $1 in
    ok | clean | 'in sync' | recorded | present | installed | 'up to date' | done) printf '%s' "$c_g" ;;
    warn | modified | untracked | added | deleted | renamed | new | skipped | missing* | *' to push' | *' behind'* \
      | *replaced* | 'not set up' | 'no upstream' | offline* | newer* | older* | unknown* | 'not '* | conflict \
      | [0-9]*', '[0-9]*[KMGT]) printf '%s' "$c_y" ;;
    error | failed | diverged* | detached*) printf '%s' "$c_r" ;;
    *) (( $2 % 2 )) && printf '%s' "$c_c" ;;
  esac
  return 0
}
table() { # SEP-separated rows on stdin, the first one the header
  local -a rows widths cells; local i n r
  mapfile -t rows
  ((${#rows[@]} > 1)) || return 0
  split() { IFS=$SEP read -r -a cells <<<"$1"; while ((${#cells[@]} < n)); do cells+=(''); done; }
  IFS=$SEP read -r -a cells <<<"${rows[0]}"; n=${#cells[@]}
  for ((i = 0; i < n; i++)); do widths[i]=0; done
  for r in "${rows[@]}"; do
    split "$r"
    for ((i = 0; i < n; i++)); do (( ${#cells[i]} > widths[i] )) && widths[i]=${#cells[i]}; done
  done
  split "${rows[0]}"
  for ((i = 0; i < n; i++)); do printf '%s%-*s%s   ' "$c_b" "${widths[i]}" "${cells[i]}" "$c_0"; done; printf '\n'
  for r in "${rows[@]:1}"; do
    split "$r"
    for ((i = 0; i < n; i++)); do printf '%s%-*s%s   ' "$(cell_colour "${cells[i]}" "$i")" "${widths[i]}" "${cells[i]}" "$c_0"; done
    printf '\n'
  done
}
run_root() { # CMD… — through sudo; records what to run by hand when no password can be asked
  if sudo -n true 2>/dev/null || { : </dev/tty; } 2>/dev/null; then
    sudo "$@"
  else
    warn sudo "no terminal for the password; by hand: sudo $*"
    return 1
  fi
}

os=other
DROP=()
detect_os() {
  local ID='' ID_LIKE='' f=${DOTS_OS_RELEASE:-/etc/os-release}
  os=other; DROP=()
  [[ -r $f ]] || return 0
  # shellcheck disable=SC1090
  . "$f"
  case $ID in
    arch | omarchy) os=arch ;;
    ubuntu) os=ubuntu ;;
    *) case $ID_LIKE in *arch*) os=arch ;; *ubuntu*) os=ubuntu ;; esac ;;
  esac
  case $os in arch) DROP=("${ARCH_DROP[@]}") ;; ubuntu) DROP=("${UBUNTU_DROP[@]}") ;; esac
}

# ── repositories ─────────────────────────────────────────────────────────────
repo_gitargs() {
  case $1 in
    public)  printf '%s\n' "--git-dir=$PUBLIC_GIT_DIR" "--work-tree=$HOME" ;;
    private) printf '%s\n' -C "$PRIVATE_DIR" ;;
    nvim)    printf '%s\n' -C "$NVIM_DIR" ;;
  esac
}
repo_git() { # NAME git-args…
  local r=$1; shift
  local -a a; mapfile -t a < <(repo_gitargs "$r")
  git "${a[@]}" "$@"
}
repo_present() {
  case $1 in
    public)  [[ -d $PUBLIC_GIT_DIR ]] ;;
    private) [[ -d $PRIVATE_DIR/.git ]] ;;
    nvim)    [[ -d $NVIM_DIR/.git ]] ;;
  esac
}
repo_label() { case $1 in public) printf dotfiles ;; private) printf private ;; nvim) printf nvim ;; esac; }
need_public() { [[ -d $PUBLIC_GIT_DIR ]] || die "no ~/.dotfiles on this machine; start with: bash <(curl -fsSL $BOOTSTRAP_URL)"; }
need_repo() { repo_present "$1" || die "the $(repo_label "$1") repo is not set up here (dots setup)"; }

repo_fetch() { # NAME FORCE — fetch origin, at most once every FETCH_TTL seconds unless forced
  local r=$1 force=$2 gd head
  gd=$(repo_git "$r" rev-parse --absolute-git-dir 2>/dev/null) || return 1
  head=$gd/FETCH_HEAD
  if (( ! force )) && [[ -f $head ]] && (( $(date +%s) - $(stat -c %Y "$head") < FETCH_TTL )); then
    return 0
  fi
  local -a a; mapfile -t a < <(repo_gitargs "$r")
  GIT_SSH_COMMAND="ssh -o BatchMode=yes -o ConnectTimeout=10" timeout 60 git "${a[@]}" fetch -q origin 2>/dev/null
}

repo_state() { # NAME — sets st_branch st_changes st_n st_upstream st_ahead st_behind
  local r=$1 counts
  st_branch=$(repo_git "$r" symbolic-ref --short -q HEAD 2>/dev/null) || st_branch=detached
  # ignore-submodules=all: the nvim work tree gets its own row; a recorded pointer that
  # moved is detected by nvim_pointer_state
  st_changes=$(repo_git "$r" status --porcelain --ignore-submodules=all 2>/dev/null)
  # a recorded nvim commit waiting in the index is a change to save; =all hides it
  if [[ $r == public ]] && ! repo_git public diff --cached --quiet --ignore-submodules=dirty -- "$NVIM_PATH" 2>/dev/null; then
    st_changes+="${st_changes:+$'\n'}M  $NVIM_PATH"
  fi
  st_n=0; [[ -n $st_changes ]] && st_n=$(wc -l <<<"$st_changes")
  st_upstream='' st_ahead=0 st_behind=0
  if st_upstream=$(repo_git "$r" rev-parse --abbrev-ref '@{upstream}' 2>/dev/null); then
    counts=$(repo_git "$r" rev-list --left-right --count '@{upstream}...HEAD' 2>/dev/null) \
      && read -r st_behind st_ahead <<<"$counts"
  fi
}
origin_text() { # after repo_state: one phrase for the origin column
  if [[ $st_branch == detached ]]; then printf 'detached HEAD'
  elif [[ -z $st_upstream ]]; then printf 'no upstream'
  elif (( st_ahead && st_behind )); then printf 'diverged %d/%d' "$st_ahead" "$st_behind"
  elif (( st_ahead )); then printf '%d to push' "$st_ahead"
  elif (( st_behind )); then printf '%d behind' "$st_behind"
  else printf 'in sync'
  fi
}
change_state() { # porcelain XY code → one word
  case $1 in
    '??') printf untracked ;;
    *U* | 'AA' | 'DD') printf conflict ;;
    *R*) printf renamed ;;
    *A*) printf added ;;
    *D*) printf deleted ;;
    *) printf modified ;;
  esac
}

repo_update() { # NAME RESET — fast-forward to the upstream (fetched already), or reset to it
  local r=$1 reset=$2 label up before after err n
  label=$(repo_label "$r")
  up=$(repo_git "$r" rev-parse --abbrev-ref '@{upstream}' 2>/dev/null) || { warn "$label" "no upstream branch"; return 1; }
  before=$(repo_git "$r" rev-parse HEAD)
  if (( reset )); then
    repo_git "$r" reset -q --hard "$up" || { warn "$label" "reset to $up failed"; return 1; }
  elif ! err=$(repo_git "$r" merge -q --ff-only --autostash "$up" 2>&1); then
    warn "$label" "cannot fast-forward to $up: ${err%%$'\n'*}"
    return 1
  fi
  after=$(repo_git "$r" rev-parse HEAD)
  if [[ $before == "$after" ]]; then
    line "$label" "up to date $(repo_git "$r" log --format='%h %s' -1)"
  else
    n=$(repo_git "$r" rev-list --count "$before..$after")
    line "$label" "$n new commit(s), now at $(repo_git "$r" log --format='%h %s' -1)"
  fi
}

push_repo() { # NAME — push when there is something to push
  local r=$1 label; label=$(repo_label "$r")
  repo_fetch "$r" 0 || true
  repo_state "$r"
  [[ -n $st_upstream ]] || { warn "$label" "no upstream branch"; return 1; }
  (( st_ahead )) || return 0
  if (( st_behind )); then
    warn "$label" "origin has $st_behind new commit(s), not pushed"
    return 1
  fi
  if repo_git "$r" push -q origin HEAD 2>/dev/null; then
    line "$label" "pushed $st_ahead commit(s)"
  else
    warn "$label" "push failed"
    return 1
  fi
}

# ── nvim: its own repo, recorded in dotfiles as a submodule pointer ──────────
nvim_pointer_state() { # prints same|ahead|behind|diverged|unknown|none
  local rec live
  rec=$(repo_git public ls-files -s -- "$NVIM_PATH" 2>/dev/null | awk '$1 == "160000" { print $2 }')
  [[ -n $rec ]] || { printf none; return; }
  live=$(repo_git nvim rev-parse HEAD 2>/dev/null) || { printf unknown; return; }
  if [[ $rec == "$live" ]]; then printf same
  elif ! repo_git nvim cat-file -e "$rec^{commit}" 2>/dev/null; then printf unknown
  elif repo_git nvim merge-base --is-ancestor "$rec" "$live" 2>/dev/null; then printf ahead
  elif repo_git nvim merge-base --is-ancestor "$live" "$rec" 2>/dev/null; then printf behind
  else printf diverged
  fi
}
nvim_pointer_text() {
  case $(nvim_pointer_state) in
    same) printf recorded ;;
    ahead) printf 'newer than recorded' ;;
    behind) printf 'older than recorded' ;;
    unknown) printf 'unknown record' ;;
    diverged) printf 'diverged from record' ;;
    none) printf 'not recorded' ;;
  esac
}
record_nvim() { # stage the live nvim commit in dotfiles when it moved forward
  repo_present nvim || return 0
  case $(nvim_pointer_state) in
    ahead | none)
      local live; live=$(repo_git nvim rev-parse HEAD) || return 0
      repo_git public update-index --add --cacheinfo "160000,$live,$NVIM_PATH" && line nvim "recorded ${live:0:7} in dotfiles" ;;
    behind)   warn nvim "older than the commit recorded in dotfiles, record left alone" ;;
    unknown)  warn nvim "the commit recorded in dotfiles is not here, record left alone" ;;
    diverged) warn nvim "diverged from the commit recorded in dotfiles, record left alone" ;;
  esac
}

# ── per-host layers: files symlinked into $HOME ──────────────────────────────
host_name() { if [[ -r $HOST_FILE ]]; then host=$(<"$HOST_FILE"); else host=$(hostname); fi; }
link_trees() { # "root|label" per tree that applies to this host
  printf '%s|%s\n' "$HOSTS_DIR/$host" "hosts/$host"
  if [[ -d $PRIVATE_DIR ]]; then
    printf '%s|%s\n' "$PRIVATE_DIR/hosts/$host" "private/hosts/$host" "$PRIVATE_DIR/common" "private/common"
  fi
}
# If a program replaced a link with a regular file (the monitor panel rewrites
# monitors.local.lua), the live file is the truth: it is copied back into
# its tree and re-linked, and shows up as a change to save.
link_tree() { # ROOT LABEL — sets lt_linked lt_adopted lt_kept
  local root=$1 label=$2 src rel dst
  lt_linked=0 lt_adopted=0 lt_kept=0
  [[ -d $root ]] || return 0
  while IFS= read -r src; do
    rel=${src#"$root"/}; dst=$HOME/$rel
    if [[ -L $dst ]]; then
      [[ $(readlink "$dst") == "$src" ]] && { lt_kept=$((lt_kept + 1)); continue; }
      rm -f "$dst"
    elif [[ -e $dst ]]; then
      if ! cmp -s "$dst" "$src"; then
        cp -p "$dst" "$src" && lt_adopted=$((lt_adopted + 1)) && line "$label" "adopted the live $rel"
      fi
      rm -f "$dst"
    fi
    mkdir -p "$(dirname "$dst")" && ln -s "$src" "$dst" && lt_linked=$((lt_linked + 1))
  done < <(find "$root" -type f 2>/dev/null)
}
# A link into one of the trees whose file is gone (moved to the shared layer, or dropped)
# is stale: it is removed. Dangling links that point anywhere else are not ours to touch.
stale_links() { # dangling links into a tree, anywhere the trees reach in $HOME
  local dst target
  while IFS= read -r dst; do
    target=$(readlink "$dst") || continue
    [[ $target == "$HOSTS_DIR"/* || $target == "$PRIVATE_DIR"/* ]] && printf '%s\n' "$dst"
  done < <(find "$HOME" -maxdepth 5 \( -path "$HOME/.cache" -o -path "$HOME/.local/share" -o -path "$HOME/.local/state" \
    -o -path "$HOME/dev" -o -path "$HOME/.dotfiles" -o -name node_modules -o -name .git -o -name '*.bak-omarchy' \) -prune -o -xtype l -print 2>/dev/null)
  return 0
}
link_all() { # QUIET — sets la_ok la_linked la_adopted la_pruned
  local root label dst
  la_ok=0 la_linked=0 la_adopted=0 la_pruned=0
  while IFS='|' read -r root label; do
    link_tree "$root" "$label"
    la_ok=$((la_ok + lt_kept + lt_linked)); la_linked=$((la_linked + lt_linked)); la_adopted=$((la_adopted + lt_adopted))
  done < <(link_trees)
  while IFS= read -r dst; do
    [[ -n $dst ]] || continue
    rm -f "$dst" && la_pruned=$((la_pruned + 1)) && line links "removed the stale ${dst#"$HOME"/}"
  done < <(stale_links)
  (( $1 )) || line links "$la_ok/$la_ok, $la_linked linked now, $la_adopted adopted$( (( la_pruned )) && printf ', %d stale removed' "$la_pruned")"
}
link_state() { # sets lk_ok lk_replaced lk_missing lk_other lk_stale lk_detail
  local root label src rel dst
  lk_ok=0 lk_replaced=0 lk_missing=0 lk_other=0 lk_stale=0 lk_detail=''
  while IFS='|' read -r root label; do
    [[ -d $root ]] || continue
    while IFS= read -r src; do
      rel=${src#"$root"/}; dst=$HOME/$rel
      if [[ -L $dst ]]; then
        if [[ $(readlink "$dst") == "$src" ]]; then lk_ok=$((lk_ok + 1))
        else lk_other=$((lk_other + 1)); lk_detail+="${lk_detail:+, }$rel elsewhere"
        fi
      elif [[ -e $dst ]]; then lk_replaced=$((lk_replaced + 1)); lk_detail+="${lk_detail:+, }$rel replaced"
      else lk_missing=$((lk_missing + 1)); lk_detail+="${lk_detail:+, }$rel missing"
      fi
    done < <(find "$root" -type f 2>/dev/null)
  done < <(link_trees)
  while IFS= read -r dst; do [[ -n $dst ]] && { lk_stale=$((lk_stale + 1)); lk_detail+="${lk_detail:+, }${dst#"$HOME"/} stale"; }; done < <(stale_links)
}
links_text() { # after link_state: "in place/expected", then what is off
  local total=$((lk_ok + lk_replaced + lk_missing + lk_other))
  if (( lk_replaced + lk_missing + lk_other + lk_stale )); then printf '%d/%d, %s' "$lk_ok" "$total" "$lk_detail"; else printf '%d/%d' "$lk_ok" "$total"; fi
}

# ── root entries: README.md, bootstrap.sh, .github live in the repo, not in $HOME ──
# A modified root entry is not hidden: git would leave the file but mark it skip-worktree,
# and the next save would skip it too. Saving first is the only way out.
root_hide() { # QUIET
  local out dirty
  dirty=$(repo_git public status --porcelain --ignore-submodules=all -- "${ROOT_ENTRIES[@]}" 2>/dev/null | awk '{ print $NF }' | paste -sd' ')
  [[ -n $dirty ]] && { warn root "$dirty changed: dots save first"; return 1; }
  out=$(repo_git public sparse-checkout set --no-cone "${ROOT_PATTERNS[@]}" 2>&1) || { warn root "sparse-checkout failed: $out"; return 1; }
  [[ -n $out ]] && warn root "${out//$'\n'/ }"
  (( $1 )) || line root "${ROOT_ENTRIES[*]} out of \$HOME"
}
root_hidden() {
  local f
  [[ $(repo_git public config --bool core.sparseCheckout 2>/dev/null) == true ]] || return 1
  for f in "${ROOT_ENTRIES[@]}"; do [[ -e $HOME/$f ]] && return 1; done
  return 0
}

# ── tools and packages ───────────────────────────────────────────────────────
mise_missing() { mise ls --missing --no-header 2>/dev/null | awk 'NF { print $1 }'; }
installed_pkgs() { # PKG… — those installed here
  local p
  case $os in
    arch) pacman -Qq "$@" 2>/dev/null ;;
    ubuntu)
      for p in "$@"; do
        [[ $(dpkg-query -W -f='${db:Status-Status}' "$p" 2>/dev/null) == installed ]] && printf '%s\n' "$p"
      done ;;
  esac
  return 0
}
missing_pkgs() { # PKG… — those not installed here
  local p
  case $os in
    arch) pacman -T "$@" 2>/dev/null ;;
    ubuntu)
      for p in "$@"; do
        [[ $(dpkg-query -W -f='${db:Status-Status}' "$p" 2>/dev/null) == installed ]] || printf '%s\n' "$p"
      done ;;
  esac
  return 0
}
stale_processes() { # "NAME PID" for replaced tools still running a removed binary
  local p exe name
  for p in /proc/[0-9]*; do
    exe=$(readlink "$p/exe" 2>/dev/null) || continue
    [[ $exe == *' (deleted)' ]] || continue
    name=${exe##*/}; name=${name% (deleted)}
    case " ${STALE_NAMES[*]} " in *" $name "*) printf '%s %s\n' "$name" "${p##*/}" ;; esac
  done
}
# Chromium extensions come from the store through a managed policy, so a fresh machine
# gets them without a Google account: the shared list plus the host's own, as one
# ExtensionInstallForcelist under /etc (Chromium reads policies from root-owned files only).
chromium_ids() { sed 's/#.*//' "$CHROMIUM_EXT" "$CHROMIUM_EXT_LOCAL" 2>/dev/null | awk 'NF { print $1 }' | sort -u; }
chromium_policy() { # the policy file's content
  local id list=''
  while IFS= read -r id; do list+="${list:+,}"$'\n'"    \"$id;https://clients2.google.com/service/update2/crx\""; done < <(chromium_ids)
  printf '{\n  "ExtensionInstallForcelist": [%s\n  ]\n}\n' "$list"
}
chromium_policy_state() { # sets cp_state current|outdated|missing, cp_n
  cp_n=$(chromium_ids | wc -l)
  if [[ ! -r $CHROMIUM_POLICY ]]; then cp_state=missing
  elif [[ $(<"$CHROMIUM_POLICY") == "$(chromium_policy)" ]]; then cp_state=current
  else cp_state=outdated
  fi
}
theme_name() { local n=${1##*/}; n=${n%.git}; n=${n#omarchy-}; printf '%s' "${n%-theme}"; }

# ── secrets: unlock 1Password once, the rest follows ─────────────────────────
# OP_ITEM holds, as fields: github-token (a gh token with repo, read:org,
# admin:public_key and admin:ssh_signing_key), tailscale-auth-key, cloudflare-token.
# The path is public, the values never leave 1Password. This machine's SSH key is
# generated here, stays here, and goes to GitHub through gh for authentication and
# signing: after setup, commits and pushes need nothing else.
op_ready() { have op && op whoami >/dev/null 2>&1; }
op_field() { op read "$OP_ITEM/$1" 2>/dev/null; }
ssh_key() { # the key ssh offers GitHub when one exists, else the one setup generates
  local f
  while read -r _ f; do
    f=${f/#\~/$HOME}
    [[ -f $f ]] && { printf '%s' "$f"; return 0; }
  done < <(ssh -G github.com 2>/dev/null | grep '^identityfile ')
  printf '%s' "$HOME/.ssh/id_ed25519"
}
tailscale_state() { local s; s=$(tailscale status --json 2>/dev/null | grep -o '"BackendState": *"[A-Za-z]*"' | head -1); s=${s%\"}; printf '%s' "${s##*\"}"; }
themes_missing() { # urls from omarchy/themes.txt whose theme is not installed
  local url
  [[ -r $HOME/.config/omarchy/themes.txt ]] || return 0
  while read -r url; do
    [[ -z $url || $url == \#* ]] && continue
    [[ -d $HOME/.config/omarchy/themes/$(theme_name "$url") ]] || printf '%s\n' "$url"
  done <"$HOME/.config/omarchy/themes.txt"
}
tmux_plugins() { sed -n 's/^set -g @plugin "\([^"]*\)".*/\1/p' "$HOME/.config/tmux/extras.conf" 2>/dev/null; }
tmux_plugins_missing() { # plugins declared in tmux/extras.conf without a clone under TPM_DIR
  local p
  while read -r p; do [[ -d $TPM_DIR/${p##*/} ]] || printf '%s\n' "${p##*/}"; done < <(tmux_plugins)
}
words() { tr '\n' ' ' <<<"$1" | sed 's/ *$//'; }

# ── checks: what doctor prints and status counts ─────────────────────────────
chk_rows='' chk_warns=0
chk() { # NAME ok|warn DETAIL
  [[ $2 == warn ]] && chk_warns=$((chk_warns + 1))
  chk_rows+="$(row "$1" "$2" "$3")"$'\n'
  return 0
}
checks_repos() { # needs the network: fetches, then compares with origin
  local r label st detail
  for r in public private nvim; do
    label=$(repo_label "$r")
    repo_present "$r" || { chk "$label" warn "not set up"; continue; }
    repo_fetch "$r" 0 || true
    repo_state "$r"
    st=ok
    detail=$( (( st_n )) && printf '%d changed' "$st_n" || printf clean )
    detail+=", $(origin_text)"
    [[ $r == nvim ]] && detail+=", $(nvim_pointer_text)"
    case $detail in *changed* | *push* | *behind* | *diverged* | *detached* | *upstream* | *newer* | *older* | *unknown* | *'not recorded'*) st=warn ;; esac
    chk "$label" "$st" "$detail"
  done
}
checks_machine() { # fast, local: what is installed and wired, against what the layer intends
  local missing n cur detail st
  local -a dup
  detect_os
  if [[ -r $HOST_FILE ]]; then chk host ok "$host"; else chk host warn "no marker, assuming $host"; fi
  link_state
  if (( lk_replaced + lk_missing + lk_other + lk_stale )); then chk links warn "$(links_text)"; else chk links ok "$(links_text)"; fi
  if root_hidden; then chk root ok "${ROOT_ENTRIES[*]} out of \$HOME"; else chk root warn "${ROOT_ENTRIES[*]} in \$HOME, or sparse checkout off"; fi
  st=ok detail=''
  if [[ -e $HOME/.config/git/local ]]; then detail="identity present"; else st=warn detail="no identity (~/.config/git/local)"; fi
  missing=$(find "$HOME/.config/git/hooks" -maxdepth 1 -type f ! -name '*.sh' ! -perm -u+x 2>/dev/null)
  if [[ -z $missing ]]; then detail+=", hooks executable"; else st=warn detail+=", hooks not executable: $(words "${missing//$HOME\//}")"; fi
  chk git "$st" "$detail"
  case $os in
    arch)
      if [[ -r /usr/share/omarchy/version ]]; then chk omarchy ok "$(</usr/share/omarchy/version)"; else chk omarchy warn "not installed"; fi
      if [[ -r $PACMAN_HOOK ]]; then chk pacman ok "install hook present"; else chk pacman warn "install hook missing"; fi ;;
    ubuntu)
      if [[ -d $PORT_DIR/.git && -e /usr/share/omarchy ]]; then chk omarchy ok "port $(git -C "$PORT_DIR" log -1 --format=%h 2>/dev/null)"; else chk omarchy warn "port not installed"; fi ;;
  esac
  case $os in
    arch)   missing=$(missing_pkgs "${ARCH_DEPS[@]}") ;;
    ubuntu) missing=$(missing_pkgs "${UBUNTU_DEPS[@]}") ;;
    *)      missing='' ;;
  esac
  if [[ $os != other ]]; then
    if [[ -z $missing ]]; then chk deps ok "all present"; else chk deps warn "missing $(words "$missing")"; fi
  fi
  if have mise; then
    st=ok detail="$(command -v mise) $(mise --version 2>/dev/null | awk '{ print $1 }')"
    [[ $(command -v mise) == "$HOME/.local/bin/mise" ]] || { st=warn detail+=" (not the official build)"; }
    missing=$(mise_missing)
    if [[ -z $missing ]]; then detail+=", every tool installed"; else st=warn detail+=", missing $(words "$missing")"; fi
    chk mise "$st" "$detail"
  else
    chk mise warn "not installed"
  fi
  if [[ -x $HOME/.cargo/bin/cargo ]]; then chk rust ok "$("$HOME/.cargo/bin/rustc" --version 2>/dev/null)"; else chk rust warn "rustup not installed"; fi
  if have augur; then chk augur ok "$(augur --version 2>/dev/null)"; else chk augur warn "not installed"; fi
  if [[ -f $HOME/.local/share/blesh/ble.sh ]]; then chk ble.sh ok present; else chk ble.sh warn "not installed"; fi
  if [[ -d $TPM_DIR/tpm ]]; then
    missing=$(tmux_plugins_missing)
    if [[ -z $missing ]]; then chk tmux ok "tpm, $(tmux_plugins | wc -l) plugins"; else chk tmux warn "plugins missing: $(words "$missing")"; fi
  else
    chk tmux warn "tpm not installed"
  fi
  mapfile -t dup < <(installed_pkgs "${DROP[@]}")
  if ((${#dup[@]})); then chk packages warn "distro copies: ${dup[*]}"; else chk packages ok "no distro copies"; fi
  have starship && chk starship warn "$(command -v starship) on PATH"
  missing=$(stale_processes)
  if [[ -n $missing ]]; then chk process warn "removed binary still running: $(awk '{ printf "%s(%s) ", $1, $2 }' <<<"$missing" | sed 's/ $//')"; fi
  if have fc-list; then
    st=ok detail=''
    if fc-list : family 2>/dev/null | grep -qF "$FONT"; then detail="$FONT installed"; else st=warn detail="$FONT not installed"; fi
    if have omarchy-font-current; then
      cur=$(omarchy-font-current 2>/dev/null)
      if [[ $cur == "$FONT" ]]; then detail+=", set"; else st=warn detail+=", Omarchy has '$cur'"; fi
    fi
    chk font "$st" "$detail"
  fi
  if [[ -r $HOME/.config/omarchy/themes.txt ]] && have omarchy-theme-install; then
    missing=$(themes_missing); n=0; [[ -n $missing ]] && n=$(wc -l <<<"$missing")
    if (( n )); then chk themes warn "$n from themes.txt not installed"; else chk themes ok "every theme in themes.txt installed"; fi
  fi
  if have kubectl; then
    if [[ -s $HOME/.local/share/bash-completion/completions/kubectl ]]; then chk kubectl ok "completion generated"; else chk kubectl warn "completion not generated"; fi
  fi
  if have chromium; then
    chromium_policy_state
    if [[ $cp_state == current ]]; then chk chromium ok "$cp_n extensions by policy"; else chk chromium warn "extension policy $cp_state: dots setup"; fi
  fi
}
checks_deep() { # slower: a real login shell, GitHub over SSH
  local out st detail key
  st=ok detail=''
  out=$(LC_ALL=C bash -lic true 2>&1 | grep -vE 'cannot set terminal process group|no job control in this shell')
  if [[ -z $out ]]; then detail="login shell clean"; else st=warn detail="login shell prints: ${out%%$'\n'*}"; fi
  out=$(bash -lic 'printf "%s|%s" "${PAGER-}" "$(command -v dots)"' 2>/dev/null)
  if [[ $out == "less|$HOME/.local/bin/dots" ]]; then detail+=", PAGER=less, dots on PATH"; else st=warn detail+=", PAGER='${out%%|*}', dots='${out#*|}'"; fi
  chk shell "$st" "$detail"
  out=$(timeout 20 ssh -o BatchMode=yes -o ConnectTimeout=8 -o StrictHostKeyChecking=accept-new -T git@github.com 2>&1)
  if [[ $out == *"successfully authenticated"* ]]; then chk github ok "ssh access"; else chk github warn "no ssh access: ${out%%$'\n'*}"; fi
  # Logins: what only a person can do. Listed so a fresh machine knows what is left.
  if have op; then
    if op whoami >/dev/null 2>&1; then chk 1password ok "CLI signed in"; else chk 1password warn "CLI not signed in: unlock the app (CLI integration on) or op signin"; fi
  fi
  if have gh; then
    if gh auth status >/dev/null 2>&1; then chk gh ok "logged in"; else chk gh warn "not logged in: gh auth login"; fi
  fi
  if have tailscale; then
    out=$(tailscale_state)
    if [[ $out == Running ]]; then chk tailscale ok "connected"; else chk tailscale warn "${out:-not running}: sudo tailscale up"; fi
  fi
  key=$(git config --get user.signingkey 2>/dev/null); key=${key/#\~/$HOME}
  if [[ -z $key ]]; then chk signing warn "no signing key configured (git/local from the per-host layer)"
  elif [[ -r $key ]]; then chk signing ok "key present"
  else chk signing warn "key $key missing: generate it and add it to GitHub as a signing key"
  fi
  if grep -qs cloudflare/token "$HOME/.config/bash/private"; then
    if [[ -r $HOME/.local/state/cloudflare/token ]]; then chk cloudflare ok "token file present"; else chk cloudflare warn "token file missing: op read into ~/.local/state/cloudflare/token"; fi
  fi
}
cmd_doctor() {
  [[ ${1:-} == -h || ${1:-} == --help ]] && { help_for doctor; return 0; }
  need_public; host_name
  chk_rows='' chk_warns=0
  checks_repos
  checks_machine
  checks_deep
  { row CHECK STATUS DETAIL; printf '%s' "$chk_rows"; } | table
  (( chk_warns == 0 ))
}

# ── status ───────────────────────────────────────────────────────────────────
overview() { # MODE auto|force|off
  local mode=$1 r label origin nv changes='' repos='' checks l
  host_name
  for r in public private nvim; do
    label=$(repo_label "$r")
    if ! repo_present "$r"; then repos+="$(row "$label" '' '' 'not set up' '')"$'\n'; continue; fi
    origin=''
    case $mode in
      force) repo_fetch "$r" 1 || origin='offline, ' ;;
      auto)  repo_fetch "$r" 0 || origin='offline, ' ;;
    esac
    repo_state "$r"
    origin+=$(origin_text)
    nv=''; [[ $r == nvim ]] && nv=$(nvim_pointer_text)
    repos+="$(row "$label" "$st_branch" "$( (( st_n )) && printf '%d changed' "$st_n" || printf clean )" "$origin" "$nv")"$'\n'
    [[ -n $st_changes ]] && while IFS= read -r l; do
      changes+="$(row "${l:3}" "$(change_state "${l:0:2}")" "$label")"$'\n'
    done <<<"$st_changes"
  done
  { row REPO BRANCH CHANGES ORIGIN NVIM; printf '%s' "$repos"; } | table
  if [[ -n $changes ]]; then
    printf '\n'
    { row PATH STATE REPO; printf '%s' "$changes"; } | table
  fi
  chk_rows='' chk_warns=0
  checks_machine
  if (( chk_warns )); then checks="$chk_warns warn"; else checks=ok; fi
  printf '\n'
  if backups_text >/dev/null; then
    { row HOST LINKS CHECKS BACKUPS; row "$host" "$(links_text)" "$checks" "$(backups_text)"; } | table
  else
    { row HOST LINKS CHECKS; row "$host" "$(links_text)" "$checks"; } | table
  fi
}
cmd_status() {
  local mode=auto
  while (($#)); do
    case $1 in
      -f | --fetch) mode=force ;;
      -o | --offline) mode=off ;;
      -h | --help) help_for status; return 0 ;;
      *) die "status: unknown flag $1" ;;
    esac
    shift
  done
  need_public
  overview "$mode"
}
cmd_diff() {
  local r untracked
  [[ ${1:-} == -h || ${1:-} == --help ]] && { help_for diff; return 0; }
  need_public
  for r in public private nvim; do
    repo_present "$r" || continue
    repo_state "$r"
    (( st_n )) || continue
    printf '%s%s%s\n' "$c_b" "$(repo_label "$r")" "$c_0"
    repo_git "$r" diff --ignore-submodules=all "$@"
    untracked=$(repo_git "$r" ls-files --others --exclude-standard)
    [[ -n $untracked ]] && { printf '%suntracked%s\n' "$c_y" "$c_0"; indent '  ' <<<"$untracked"; }
  done
  return 0
}

# ── save: commit and push everything ─────────────────────────────────────────
default_message() { # PORCELAIN — "chore: update a, b, c"
  local l path names='' n=0
  while IFS= read -r l; do
    [[ -n $l ]] || continue
    path=${l:3}; path=${path##* -> }
    n=$((n + 1)); (( n <= 3 )) && names+="${names:+, }${path##*/}"
  done <<<"$1"
  (( n > 3 )) && names+=" and $((n - 3)) more"
  printf 'chore: update %s' "$names"
}
ask_message() { # PORCELAIN — asks on a terminal, otherwise the default
  local default m; default=$(default_message "$1")
  if [[ -t 0 ]]; then
    read -rep "message [$default]: " m || return 1
    printf '%s' "${m:-$default}"
  else
    printf '%s' "$default"
  fi
}
cmd_save() {
  local msg='' push=1 r label m any=0 l
  while (($#)); do
    case $1 in
      -m | --message) msg=${2:?-m needs a message}; shift ;;
      -n | --no-push) push=0 ;;
      -h | --help) help_for save; return 0 ;;
      *) die "save: unknown flag $1" ;;
    esac
    shift
  done
  need_public; host_name
  link_all 1
  for r in nvim private public; do
    repo_present "$r" || continue
    label=$(repo_label "$r")
    [[ $r == public ]] && record_nvim
    repo_state "$r"
    if (( st_n )); then
      any=1
      while IFS= read -r l; do line "$label" "$(change_state "${l:0:2}") ${l:3}"; done <<<"$st_changes"
      m=$msg
      [[ -n $m ]] || m=$(ask_message "$st_changes") || { warn "$label" "skipped"; continue; }
      if repo_git "$r" add -A && repo_git "$r" commit -q -m "$m"; then
        line "$label" "committed $(repo_git "$r" log --format='%h %s' -1)"
      else
        warn "$label" "commit failed"; continue
      fi
    fi
    (( push )) && push_repo "$r"
  done
  (( any )) || line dots "nothing to commit"
  return 0
}
cmd_push() {
  local r
  [[ ${1:-} == -h || ${1:-} == --help ]] && { help_for push; return 0; }
  need_public
  for r in nvim private public; do repo_present "$r" && push_repo "$r"; done
  return 0
}

# ── update: bring the machine up to date ─────────────────────────────────────
cmd_update() {
  local quick=0 r missing
  while (($#)); do
    case $1 in
      --quick) quick=1 ;;
      -h | --help) help_for update; return 0 ;;
      *) die "update: unknown flag $1" ;;
    esac
    shift
  done
  need_public; host_name; detect_os; mkdir -p "$STATE_DIR"
  for r in public private nvim; do
    repo_present "$r" || continue
    if repo_fetch "$r" 1; then repo_update "$r" 0; else warn "$(repo_label "$r")" "cannot reach origin"; fi
  done
  link_all 0
  if have mise; then
    missing=$(mise_missing)
    if [[ -n $missing ]]; then
      line mise "installing $(words "$missing")"
      if mise install -y >"$STATE_DIR/mise-install.log" 2>&1; then line mise installed; else warn mise "install failed, log $STATE_DIR/mise-install.log"; fi
    else
      line mise "nothing missing"
    fi
    if (( ! quick )); then
      if mise upgrade >"$STATE_DIR/mise-upgrade.log" 2>&1; then line mise "upgraded, log $STATE_DIR/mise-upgrade.log"; else warn mise "upgrade failed, log $STATE_DIR/mise-upgrade.log"; fi
    fi
    mise reshim >/dev/null 2>&1 || true
  fi
  if (( ! quick )); then
    skip_rust=0; [[ -x $HOME/.cargo/bin/cargo ]] || skip_rust=1
    step_augur
    if [[ -x $TPM_DIR/tpm/bin/update_plugins ]]; then
      if TMUX_PLUGIN_MANAGER_PATH=$TPM_DIR "$TPM_DIR/tpm/bin/update_plugins" all >/dev/null 2>&1; then line tmux "plugins updated"; else warn tmux "plugin update failed"; fi
    fi
  fi
}

# ── setup: install or repair the whole layer ─────────────────────────────────
step_deps() {
  local -a want missing
  case $os in
    arch)   want=("${ARCH_DEPS[@]}") ;;
    ubuntu) want=("${UBUNTU_DEPS[@]}") ;;
    *) line deps "unknown distro, untouched"; return 0 ;;
  esac
  mapfile -t missing < <(missing_pkgs "${want[@]}")
  ((${#missing[@]})) || { line deps "all present"; return 0; }
  line deps "installing ${missing[*]}"
  local ok=0
  case $os in
    arch)   run_root pacman -S --needed --noconfirm "${missing[@]}" >/dev/null && ok=1 ;;
    ubuntu) run_root apt-get update -qq >/dev/null 2>&1; run_root env DEBIAN_FRONTEND=noninteractive apt-get install -y -qq "${missing[@]}" >/dev/null && ok=1 ;;
  esac
  if (( ok )); then line deps installed; else warn deps "install failed: ${missing[*]}"; fi
  hash -r
}
step_omarchy() {
  if (( skip_omarchy )); then line omarchy "skipped"; return 0; fi
  case $os in
    arch)
      if [[ -r /usr/share/omarchy/version ]]; then line omarchy "$(</usr/share/omarchy/version)"; else warn omarchy "not installed (needs the Omarchy ISO)"; fi ;;
    ubuntu)
      if [[ ! -d $PORT_DIR/.git ]]; then
        git clone -q "$PORT_REPO" "$PORT_DIR" || die "cannot clone $PORT_REPO"
        line omarchy "cloned omarchy-ubuntu"
      else
        git -C "$PORT_DIR" pull -q --ff-only 2>/dev/null || warn omarchy "omarchy-ubuntu pull skipped"
      fi
      line omarchy "running omarchy-ubuntu/bootstrap.sh"
      # the port writes into tracked files on re-runs (terminal templates, a block in
      # .bashrc, `mise use --global` in mise/config.toml); those files are ours, so
      # whatever was clean before the run comes back from the repo afterwards
      local before after f restored=''
      before=$(repo_git public status --porcelain --ignore-submodules=all -- . 2>/dev/null | awk '{ print $2 }')
      "$PORT_DIR/bootstrap.sh" || die "omarchy-ubuntu bootstrap failed"
      after=$(repo_git public status --porcelain --ignore-submodules=all -- . 2>/dev/null | awk '$1 != "??" { print $2 }')
      for f in $after; do
        grep -qx "$f" <<<"$before" && continue
        repo_git public checkout -q -- "$f" 2>/dev/null && restored+="${restored:+ }$f"
      done
      [[ -n $restored ]] && line omarchy "restored after the port's run: $restored"
      line omarchy "port $(git -C "$PORT_DIR" log -1 --format=%h)" ;;
    *) warn omarchy "unsupported distro, skipped" ;;
  esac
}
step_repo() {
  repo_git public config status.showUntrackedFiles normal
  repo_git public config remote.origin.fetch "+refs/heads/*:refs/remotes/origin/*"
  repo_git public config remote.origin.pushurl "$PUBLIC_PUSH_URL"
  repo_git public config core.sparseCheckout true
  repo_git public config core.sparseCheckoutCone false
  if repo_fetch public 1; then
    repo_git public branch -q --set-upstream-to="origin/$PUBLIC_BRANCH" "$PUBLIC_BRANCH" 2>/dev/null
    repo_update public "$reset"
  else
    warn dotfiles "cannot reach origin, local checkout kept"
  fi
  root_hide 1
}
step_host() {
  local h=''
  if [[ -n $host_opt ]]; then
    printf '%s\n' "$host_opt" >"$HOST_FILE"
  elif [[ ! -r $HOST_FILE ]]; then
    [[ -t 0 ]] && read -rp "host name for the per-host layers [$(hostname)]: " h
    printf '%s\n' "${h:-$(hostname)}" >"$HOST_FILE"
  fi
  host_name
  line host "$host"
}
step_secrets() { # before the private layer: gh, this machine's key on GitHub, tailscale
  local a
  if (( skip_secrets )); then line secrets "skipped"; return 0; fi
  if ! have op; then warn secrets "1Password CLI (op) not installed; logins stay by hand"; return 0; fi
  if ! op_ready; then
    if [[ -t 0 ]]; then
      read -rp "unlock 1Password (Settings > Developer > CLI integration) and press Enter, s to skip: " a
      [[ $a == s ]] && { line secrets "skipped"; return 0; }
      op_ready || { warn secrets "1Password not signed in; rerun dots setup once it is"; return 0; }
    else
      warn secrets "1Password CLI not signed in; run dots setup on a terminal"; return 0
    fi
  fi
  line 1password "signed in"
  secrets_gh && secrets_key
  secrets_tailscale
  return 0
}
secrets_gh() {
  local t
  have gh || { warn gh "not installed"; return 1; }
  if gh auth status >/dev/null 2>&1; then line gh "logged in"; return 0; fi
  t=$(op_field github-token)
  [[ -n $t ]] || { warn gh "not logged in and $OP_ITEM/github-token not set"; return 1; }
  if gh auth login --with-token <<<"$t" >/dev/null 2>&1; then line gh "logged in with the token from 1Password"; else warn gh "login with the token from 1Password failed"; return 1; fi
}
secrets_key() { # generated here, on GitHub for authentication and (unless another key signs) signing
  local key pub title sk
  key=$(ssh_key); title="${host^} (on-disk)"
  if [[ ! -f $key ]]; then
    mkdir -p "$HOME/.ssh" && chmod 700 "$HOME/.ssh"
    ssh-keygen -q -t ed25519 -N '' -C "$host" -f "$key" || { warn ssh "could not generate ${key/#$HOME/\~}"; return 1; }
    line ssh "generated ${key/#$HOME/\~}"
  fi
  pub=$(cut -d' ' -f1,2 <"$key.pub")
  if gh api user/keys --jq '.[].key' 2>/dev/null | grep -qxF "$pub"; then line ssh "key on GitHub"
  elif gh ssh-key add "$key.pub" --title "$title" >/dev/null 2>&1; then line ssh "key added to GitHub as $title"
  else warn ssh "could not add the key to GitHub (token scope admin:public_key?)"
  fi
  sk=$(git config --get user.signingkey 2>/dev/null); sk=${sk/#\~/$HOME}
  if [[ -n $sk && $sk != "$key.pub" ]]; then line signing "another key signs here (${sk/#$HOME/\~})"; return 0; fi
  if gh api user/ssh_signing_keys --jq '.[].key' 2>/dev/null | grep -qxF "$pub"; then line signing "key on GitHub"
  elif gh ssh-key add "$key.pub" --type signing --title "$title" >/dev/null 2>&1; then line signing "key added to GitHub as $title"
  else warn signing "could not add the signing key to GitHub (token scope admin:ssh_signing_key?)"
  fi
}
secrets_tailscale() {
  local k tmp
  have tailscale || return 0
  [[ $(tailscale_state) == Running ]] && { line tailscale "connected"; return 0; }
  k=$(op_field tailscale-auth-key)
  [[ -n $k ]] || { warn tailscale "not connected and $OP_ITEM/tailscale-auth-key not set: sudo tailscale up"; return 0; }
  tmp=$(mktemp) && printf '%s\n' "$k" >"$tmp"
  if run_root tailscale up --auth-key "file:$tmp" >/dev/null 2>&1; then line tailscale "connected with the auth key from 1Password"; else warn tailscale "tailscale up failed"; fi
  rm -f "$tmp"
}
step_identity() { # after the links: git identity, this key among the allowed signers, token files
  local f=$HOME/.config/git/local key pub sk signers principals t email=''
  key=$(ssh_key)
  if [[ ! -e $f ]]; then
    [[ -t 0 ]] && read -rp "git email for this host [$PERSONAL_EMAIL]: " email
    printf '[user]\n\temail = %s\n\tsigningkey = %s\n' "${email:-$PERSONAL_EMAIL}" "${key/#$HOME/\~}.pub" >"$f"
    line git "identity written to ~/.config/git/local (this host only)"
  fi
  signers=$PRIVATE_DIR/common/.config/git/allowed_signers
  sk=$(git config --get user.signingkey 2>/dev/null); sk=${sk/#\~/$HOME}
  if [[ -f $key.pub && -f $signers && $sk == "$key.pub" ]]; then
    pub=$(cut -d' ' -f1,2 <"$key.pub")
    if ! grep -qF "$pub" "$signers"; then
      principals=$(awk '!/^#/ && NF { p = $1 } END { print p }' "$signers"); principals=${principals:-$PERSONAL_EMAIL}
      printf '# %s - added by dots setup %s (%s)\n%s %s\n' "$host" "$(date +%F)" "${key/#$HOME/\~}" "$principals" "$pub" >>"$signers"
      line signers "this host's key added to allowed_signers; dots save publishes it"
    fi
  fi
  if grep -qs cloudflare/token "$HOME/.config/bash/private" && [[ ! -r $HOME/.local/state/cloudflare/token ]] && op_ready; then
    t=$(op_field cloudflare-token)
    if [[ -n $t ]]; then
      mkdir -p "$HOME/.local/state/cloudflare" && (umask 077; printf '%s\n' "$t" >"$HOME/.local/state/cloudflare/token") && line cloudflare "token written from 1Password"
    else warn cloudflare "token file missing and $OP_ITEM/cloudflare-token not set"
    fi
  fi
  return 0
}
step_private() {
  if (( skip_private )); then line private "skipped"; return 0; fi
  if ! GIT_SSH_COMMAND="ssh -o BatchMode=yes -o ConnectTimeout=10" git ls-remote -q "$PRIVATE_REPO" HEAD >/dev/null 2>&1; then
    warn private "no ssh access to $PRIVATE_REPO, skipped"
    return 0
  fi
  if [[ ! -d $PRIVATE_DIR/.git ]]; then
    git clone -q "$PRIVATE_REPO" "$PRIVATE_DIR" || die "cannot clone $PRIVATE_REPO"
    line private "cloned $(repo_git private log --format='%h %s' -1)"
  elif repo_fetch private 1; then
    repo_update private "$reset"
  else
    warn private "cannot reach origin, local clone kept"
  fi
}
step_nvim() {
  if [[ -d $NVIM_DIR && ! -d $NVIM_DIR/.git ]]; then
    if [[ -z $(ls -A "$NVIM_DIR") ]]; then rmdir "$NVIM_DIR"; else mv "$NVIM_DIR" "$STATE_DIR/nvim-$(date +%s)"; line nvim "moved a non-git ~/.config/nvim to $STATE_DIR"; fi
  fi
  if [[ ! -d $NVIM_DIR/.git ]]; then
    git clone -q -b "$NVIM_BRANCH" "$NVIM_REPO" "$NVIM_DIR" || die "cannot clone $NVIM_REPO"
    line nvim "cloned $(repo_git nvim log --format='%h %s' -1)"
  elif repo_fetch nvim 1; then
    repo_update nvim 0
  else
    warn nvim "cannot reach origin, local clone kept"
  fi
  repo_git nvim remote set-url --push origin "$NVIM_PUSH_URL"
}
drop_pkgs() { # PKG… — one removal transaction
  case $os in
    arch)   run_root pacman -Rns --noconfirm "$@" >/dev/null 2>&1 ;;
    ubuntu) run_root apt-get remove -y "$@" >/dev/null 2>&1 ;;
  esac
}
step_drop_packages() {
  local -a dup left; local p
  mapfile -t dup < <(installed_pkgs "${DROP[@]}")
  ((${#dup[@]})) || { line packages "no distro copies"; return 0; }
  line packages "removing ${dup[*]}"
  # all at once first, so packages that depend on each other (rust-src, rust-analyzer
  # on rust) go in one transaction; then one by one, so an outside dependency blocks
  # only its own package
  if ! drop_pkgs "${dup[@]}"; then
    for p in "${dup[@]}"; do drop_pkgs "$p" || true; done
  fi
  mapfile -t left < <(installed_pkgs "${dup[@]}")
  if ((${#left[@]})); then warn packages "still installed: ${left[*]}"; else line packages removed; fi
  hash -r
}
step_pacman_hook() { # Arch: the pacman hook that records explicit installs in packages/arch
  [[ $os == arch ]] || return 0
  if [[ -r $PACMAN_HOOK ]]; then line pacman "install hook present"; return 0; fi
  if "$HOME/.config/scripts/install-pkg-snapshot-hook.sh" >/dev/null 2>&1; then line pacman "install hook installed"; else warn pacman "install hook not installed"; fi
}
step_rust() {
  if (( skip_rust )); then line rust "skipped"; return 0; fi
  if [[ -x $HOME/.cargo/bin/cargo ]]; then
    line rust "$("$HOME/.cargo/bin/rustc" --version 2>/dev/null)"
  else
    have curl || die "curl is required to install rustup"
    if curl --proto '=https' --tlsv1.2 -fsSL https://sh.rustup.rs | sh -s -- -y -q --no-modify-path >/dev/null; then line rust "installed $("$HOME/.cargo/bin/rustc" --version 2>/dev/null)"; else die "rustup install failed"; fi
  fi
}
step_augur() {
  if (( skip_rust )); then line augur "skipped"; return 0; fi
  local build=0 before
  if [[ ! -d $AUGUR_DIR/.git ]]; then
    git clone -q "$AUGUR_REPO" "$AUGUR_DIR" || die "cannot clone $AUGUR_REPO"
    git -C "$AUGUR_DIR" remote set-url --push origin "$AUGUR_PUSH_URL"
    build=1
  else
    before=$(git -C "$AUGUR_DIR" rev-parse HEAD)
    git -C "$AUGUR_DIR" pull -q --ff-only 2>/dev/null || true
    [[ $(git -C "$AUGUR_DIR" rev-parse HEAD) != "$before" ]] && build=1
  fi
  have augur || build=1
  if (( build )); then
    line augur "building $(git -C "$AUGUR_DIR" log -1 --format=%h)"
    if "$HOME/.cargo/bin/cargo" install -q --path "$AUGUR_DIR" 2>"$STATE_DIR/augur-build.log"; then line augur "installed $(augur --version 2>/dev/null)"; else warn augur "build failed, log $STATE_DIR/augur-build.log"; fi
  else
    line augur "$(augur --version 2>/dev/null)"
  fi
}
step_blesh() {
  local tmp
  if [[ -f $HOME/.local/share/blesh/ble.sh ]]; then
    line ble.sh present
  elif ! have make || ! have gawk; then
    warn ble.sh "needs make and gawk, skipped"
  else
    tmp=$(mktemp -d)
    if git clone -q --recursive --depth 1 --shallow-submodules https://github.com/akinomyoga/ble.sh.git "$tmp/ble.sh" \
      && make -s -C "$tmp/ble.sh" install PREFIX="$HOME/.local" >/dev/null; then line ble.sh installed; else warn ble.sh "install failed"; fi
    rm -rf "$tmp"
  fi
}
step_tpm() {
  [[ -d $TPM_DIR/tpm ]] || git clone -q https://github.com/tmux-plugins/tpm "$TPM_DIR/tpm"
  if have tmux; then
    if TMUX_PLUGIN_MANAGER_PATH=$TPM_DIR "$TPM_DIR/tpm/bin/install_plugins" >/dev/null 2>&1; then line tmux "tpm, $(tmux_plugins | wc -l) plugins"; else warn tmux "plugin install failed"; fi
  else
    warn tmux "tmux not installed, plugins pending"
  fi
}
step_mise() {
  if (( skip_mise )); then line mise "skipped"; return 0; fi
  if ! have mise; then
    have curl || die "curl is required to install mise"
    if curl -fsSL https://mise.run | MISE_INSTALL_PATH="$HOME/.local/bin/mise" sh >/dev/null 2>&1; then line mise "installed ~/.local/bin/mise"; else die "mise install failed"; fi
  fi
  line mise "$(command -v mise) $(mise --version 2>/dev/null | awk '{ print $1 }'), installing tools"
  if mise install -y >"$STATE_DIR/mise-install.log" 2>&1; then line mise "$(mise ls --no-header 2>/dev/null | awk 'NF' | wc -l) tools installed"; else warn mise "some tools failed, log $STATE_DIR/mise-install.log"; fi
  mise reshim >/dev/null 2>&1 || true
}
step_font() {
  (( skip_omarchy )) && return 0
  have omarchy-font-set || return 0
  if ! fc-list : family 2>/dev/null | grep -qF "$FONT"; then
    warn font "$FONT not installed"
  elif omarchy-font-current 2>/dev/null | grep -qF "$FONT"; then
    line font "$FONT"
  else
    omarchy-font-set "$FONT" >/dev/null 2>&1
    # font-set rewrites the terminal configs (and pins foot to size 9); fontconfig is what
    # we wanted from it, the terminal files come back from the repo
    repo_git public checkout -q -- .config/foot/foot.ini .config/alacritty/alacritty.toml .config/ghostty/config .config/kitty/kitty.conf
    line font "set $(omarchy-font-current 2>/dev/null)"
  fi
}
step_themes() {
  (( skip_omarchy )) && return 0
  have omarchy-theme-install || return 0
  [[ -r $HOME/.config/omarchy/themes.txt ]] || return 0
  local url n=0
  while read -r url; do
    [[ -n $url ]] || continue
    if omarchy-theme-install "$url" >/dev/null 2>&1; then n=$((n + 1)); else warn themes "install failed: $url"; fi
  done < <(themes_missing)
  line themes "$n installed now, $(find "$HOME/.config/omarchy/themes" -mindepth 1 -maxdepth 1 2>/dev/null | wc -l) present"
}
step_chromium() { # the extension policy under /etc, from the shared and per-host lists
  local tmp
  have chromium || return 0
  chromium_policy_state
  if [[ $cp_state == current ]]; then line chromium "$cp_n extensions by policy"; return 0; fi
  tmp=$(mktemp) && chromium_policy >"$tmp"
  if run_root install -Dm644 "$tmp" "$CHROMIUM_POLICY"; then line chromium "policy written, $cp_n extensions"; else warn chromium "policy not written; by hand: sudo install -Dm644 $tmp $CHROMIUM_POLICY"; return 0; fi
  rm -f "$tmp"
}
step_completions() {
  local comp=$HOME/.local/share/bash-completion/completions a
  mkdir -p "$comp"
  if have kubectl; then
    kubectl completion bash >"$comp/kubectl" 2>/dev/null
    for a in kubecolor k; do
      # shellcheck disable=SC2016
      printf 'source "$HOME/.local/share/bash-completion/completions/kubectl"\ncomplete -o default -F __start_kubectl %s\n' "$a" >"$comp/$a"
    done
    line kubectl "completion for kubectl, kubecolor, k"
  fi
}
setup_steps() {
  step_deps
  step_omarchy
  step_repo
  step_host
  step_secrets
  step_private
  link_all 0
  step_identity
  step_nvim
  step_drop_packages
  step_pacman_hook
  step_rust
  step_augur
  step_blesh
  step_tpm
  step_mise
  step_font
  step_themes
  step_completions
  step_chromium
  printf '\n'
  cmd_doctor || true
  printf '\n'
  if ((${#WARNINGS[@]})); then
    warn setup "${#WARNINGS[@]} warning(s) above, log $STATE_DIR/setup.log"
  else
    line setup "done, log $STATE_DIR/setup.log"
  fi
  return 0
}
cmd_setup() {
  local args="$*" log
  host_opt='' reset=0 skip_omarchy=0 skip_private=0 skip_mise=0 skip_rust=0 skip_secrets=0
  while (($#)); do
    case $1 in
      --host) host_opt=${2:?--host needs a name}; shift ;;
      --reset) reset=1 ;;
      --skip-omarchy) skip_omarchy=1 ;;
      --skip-private) skip_private=1 ;;
      --skip-mise) skip_mise=1 ;;
      --skip-rust) skip_rust=1 ;;
      --skip-secrets) skip_secrets=1 ;;
      -h | --help) help_for setup; return 0 ;;
      *) die "setup: unknown flag $1" ;;
    esac
    shift
  done
  need_public; detect_os
  mkdir -p "$STATE_DIR" "$HOME/.local/bin" "$HOME/.config/dotfiles"
  log=$STATE_DIR/setup.log
  printf '\n===== %s  dots setup %s\n' "$(date '+%F %T')" "$args" >>"$log"
  setup_steps 2>&1 | tee -a "$log"
  return "${PIPESTATUS[0]}"
}

# ── root entries ─────────────────────────────────────────────────────────────
cmd_root() {
  case ${1:-} in
    show) need_public; repo_git public sparse-checkout disable && line root "${ROOT_ENTRIES[*]} in \$HOME" ;;
    hide) need_public; root_hide 0 ;;
    -h | --help) help_for root ;;
    *) die "usage: dots root show|hide" ;;
  esac
}

# ── clean: what was moved aside instead of deleted ───────────────────────────
# bootstrap.sh (pre-checkout-*), setup (nvim-*) and the Ubuntu port (*.bak-omarchy)
# keep what they replace; dotfiles-cleanup-* is the same done by hand. Logs stay.
backups() { # one path per line; one inside another listed one is left to its parent
  local p q
  local -a found=()
  for p in "$STATE_DIR"/pre-checkout-* "$STATE_DIR"/nvim-* "$HOME"/.local/state/dotfiles-cleanup-* \
    "$HOME"/.config/*.bak-omarchy "$HOME"/.config/*/*.bak-omarchy; do
    [[ -e $p ]] && found+=("$p")
  done
  for p in "${found[@]}"; do
    for q in "${found[@]}"; do [[ $p == "$q"/* ]] && continue 2; done
    printf '%s\n' "$p"
  done
  return 0
}
backups_text() { # "N, SIZE"; false when there is none
  local -a paths
  mapfile -t paths < <(backups)
  ((${#paths[@]})) || return 1
  printf '%d, %s' "${#paths[@]}" "$(LC_ALL=C du -shc "${paths[@]}" 2>/dev/null | tail -1 | cut -f1)"
}
backup_age() { # PATH — days since it was made
  local days=$(( ($(date +%s) - $(stat -c %Y "$1")) / 86400 ))
  (( days )) && printf '%dd' "$days" || printf today
}
cmd_clean() {
  local all=0 yes=0 p listing='' answer
  local -a paths
  while (($#)); do
    case $1 in
      --all) all=1 ;;
      -y | --yes) yes=1 ;;
      -h | --help) help_for clean; return 0 ;;
      *) die "clean: unknown flag $1" ;;
    esac
    shift
  done
  mapfile -t paths < <(backups)
  ((${#paths[@]})) || { line backups none; return 0; }
  for p in "${paths[@]}"; do listing+="$(row "${p/#"$HOME"/\~}" "$(backup_age "$p")" "$(LC_ALL=C du -sh "$p" 2>/dev/null | cut -f1)")"$'\n'; done
  { row BACKUP AGE SIZE; printf '%s' "$listing"; } | table
  (( all )) || { printf '\n%s\n' "dots clean --all removes them"; return 0; }
  if (( ! yes )); then
    [[ -t 0 ]] || die "clean: no terminal to confirm on; use --all -y"
    read -rp "remove ${#paths[@]} backup(s), $(backups_text | cut -d, -f2 | tr -d ' ')? [y/N] " answer
    [[ $answer == [yY]* ]] || { line clean "kept"; return 0; }
  fi
  for p in "${paths[@]}"; do
    if rm -rf -- "$p"; then line clean "removed ${p/#"$HOME"/\~}"; else warn clean "could not remove ${p/#"$HOME"/\~}"; fi
  done
}

main() {
  local sub=${1:-status}
  (($#)) && shift
  case $sub in
    status)  cmd_status "$@" ;;
    diff)    cmd_diff "$@" ;;
    save)    cmd_save "$@" ;;
    update)  cmd_update "$@" ;;
    push)    cmd_push "$@" ;;
    doctor)  cmd_doctor "$@" ;;
    setup)   cmd_setup "$@" ;;
    root)    cmd_root "$@" ;;
    clean)   cmd_clean "$@" ;;
    private) need_repo private; repo_git private "$@" ;;
    nvim)    need_repo nvim; repo_git nvim "$@" ;;
    git)     need_public; repo_git public "$@" ;;
    help)    help_for "${1:-}" ;;
    -h | --help) usage ;;
    *)       need_public; repo_git public "$sub" "$@" ;;
  esac
}
if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
  set -u
  main "$@"
fi
