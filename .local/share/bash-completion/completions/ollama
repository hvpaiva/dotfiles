# bash completion for ollama(1)
#
# Upstream disables cobra's "completion" command, so this is hand-written.
# Model arguments are completed from the locally installed models. Written against
# the API that bash-completion 2.11 (Ubuntu 24.04) has and 2.12+ keeps as compat
# functions.

# _comp_cmd_ollama__add WORDS: append to COMPREPLY the words in WORDS that start with $cur
_comp_cmd_ollama__add()
{
    local -a matches
    mapfile -t matches < <(compgen -W "$1" -- "$cur")
    COMPREPLY+=("${matches[@]}")
}

_comp_cmd_ollama__models()
{
    _comp_cmd_ollama__add "$(ollama list 2>/dev/null | awk 'NR > 1 { print $1 }')"
}

_comp_cmd_ollama()
{
    local cur prev words cword
    _init_completion || return

    local subcommands='serve create show run stop pull push signin signout
        list ps cp rm launch help'

    local i subcommand=""
    for ((i = 1; i < cword; i++)); do
        if [[ ${words[i]} != -* ]]; then
            subcommand=${words[i]}
            break
        fi
    done

    if [[ ! $subcommand ]]; then
        if [[ $cur == -* ]]; then
            _comp_cmd_ollama__add '--help --version'
        else
            _comp_cmd_ollama__add "$subcommands"
        fi
        return
    fi

    case $prev in
        -f | --file)
            _filedir
            return
            ;;
    esac

    if [[ $cur == -* ]]; then
        case $subcommand in
            run) _comp_cmd_ollama__add '--format --hidethinking --keepalive --nowordwrap --think --verbose' ;;
            serve) _comp_cmd_ollama__add '--help' ;;
            show) _comp_cmd_ollama__add '--license --modelfile --parameters --system --template --verbose' ;;
            create) _comp_cmd_ollama__add '--file --quantize' ;;
            list | ps) _comp_cmd_ollama__add '--help' ;;
            *) _comp_cmd_ollama__add '--help' ;;
        esac
        return
    fi

    case $subcommand in
        run | show | stop | push | rm | cp)
            _comp_cmd_ollama__models
            ;;
        create)
            # first arg is the new model name, nothing to complete
            ;;
        help)
            _comp_cmd_ollama__add "$subcommands"
            ;;
    esac
}
complete -F _comp_cmd_ollama ollama
