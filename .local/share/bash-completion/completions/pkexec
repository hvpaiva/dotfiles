# bash completion for pkexec(1)
#
# pkexec wraps a command like sudo does, so hand the rest of the line to the
# wrapped command's own completion. Unlike sudo it needs an absolute path, and
# it clears the environment, so only PATH lookups are offered for the command.
# Written against the API that bash-completion 2.11 (Ubuntu 24.04) has and 2.12+
# keeps as compat functions.

_comp_cmd_pkexec()
{
    local cur prev words cword split
    _init_completion -s || return

    local i
    for ((i = 1; i <= cword; i++)); do
        if [[ ${words[i]} != -* ]]; then
            local PATH=$PATH:/sbin:/usr/sbin:/usr/local/sbin
            # shellcheck disable=SC2034 # the names 2.11 and 2.12+ read, as sudo's completion
            local root_command=$1 _comp_root_command=$1
            _command_offset $i
            return
        fi
        [[ ${words[i]} == @(--user|-u) ]] && ((i++))
    done

    case $prev in
        --user | -u)
            mapfile -t COMPREPLY < <(compgen -u -- "$cur")
            return
            ;;
    esac

    $split && return

    if [[ $cur == -* ]]; then
        local options
        options=$(_parse_help "$1")
        mapfile -t COMPREPLY < <(compgen -W "$options" -- "$cur")
        return
    fi

    mapfile -t COMPREPLY < <(compgen -c -- "$cur")
}
complete -F _comp_cmd_pkexec pkexec
