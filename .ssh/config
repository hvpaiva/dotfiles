# Keys: one per machine, on disk, named after the machine on GitHub; which one is in
# config.local (hosts/<host>). Between machines and over Tailscale SSH no key is needed.
# The 1Password agent is off by default (IdentityAgent none); to use it once:
#   ssh -o IdentityAgent=~/.1password/agent.sock -o IdentitiesOnly=no <host>
Include ~/.ssh/config.local

Host *
	IdentityAgent none
	IdentitiesOnly yes
